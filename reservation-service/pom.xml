<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.acme</groupId>
    <artifactId>reservation-service</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>quarkus</packaging>

    <properties>
        <compiler-plugin.version>3.15.0</compiler-plugin.version>
        <lombok.version>1.18.46</lombok.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <quarkus.platform.artifact-id>quarkus-bom</quarkus.platform.artifact-id>
        <quarkus.platform.group-id>io.quarkus.platform</quarkus.platform.group-id>
        <quarkus.platform.version>3.39.3</quarkus.platform.version>
        <skipITs>true</skipITs>
        <surefire-plugin.version>3.5.6</surefire-plugin.version>
        <!-- Testes de discovery selecionados por backend: por padrao a suite roda sem os
             @Tag("kubernetes"); com -P kubernetes exclui os @Tag("consul") e inclui os kubernetes. -->
        <acme.test.discovery.excludedGroups>kubernetes</acme.test.discovery.excludedGroups>
        <!-- Imagem quarkus-container-image: o nome acme/<artifactId>:<version> e o MESMO
             que o compose consome (ACME_IMAGE_TAG) e que o quarkus-kubernetes embute nos
             manifests (-P kubernetes). O build em si so acontece com o profile docker. -->
        <quarkus.container-image.group>acme</quarkus.container-image.group>
        <quarkus.container-image.name>${project.artifactId}</quarkus.container-image.name>
        <quarkus.container-image.tag>${project.version}</quarkus.container-image.tag>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>${quarkus.platform.artifact-id}</artifactId>
                <version>${quarkus.platform.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-jackson</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-rest-client-jackson</artifactId>
        </dependency>
        <!-- Cap.7.1/7.7 - Hibernate Reactive (Panache) + driver PostgreSQL reativo. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-reactive-panache</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-reactive-pg-client</artifactId>
        </dependency>
        <!-- Cap.7.4 - REST Data (versão reativa, seção 7.7): CRUD gerado em /admin/reservation. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-hibernate-reactive-rest-data-panache</artifactId>
        </dependency>
        <!-- Cap.6.2.1: validação de tokens Bearer (OIDC) recebidos do users-service -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-oidc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-openapi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-graphql-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-health</artifactId>
        </dependency>
        <!--
            Cap.10 item 8 - fault tolerance (SmallRye Fault Tolerance / MicroProfile FT).
            A política fica nas annotations dos adapters de saída (RentalRestGateway e
            GraphQLInventoryGateway); ver docs/adr/009-fault-tolerance-chamadas-externas.md.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-fault-tolerance</artifactId>
        </dependency>
        <!-- Cap.10 item 9 - discovery de saida (Stork) para o rental; o proprio registro no
        Consul e por adapter proprio (ConsulServiceRegistration), porque o auto-registro
        do Stork em 3.39.3 registra health-check-url relativo e deregistra apos o CDI
        fechado - ver docs/knowledge/14-cloud-native-patterns.md secao 1.7. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-smallrye-stork</artifactId>
        </dependency>
        <dependency>
            <groupId>io.smallrye.stork</groupId>
            <artifactId>stork-service-discovery-consul</artifactId>
        </dependency>
        <!-- Cap.10 item 10 (roadmap item 10) - discovery via Kubernetes: o mesmo
        Stork, outro provider (type=kubernetes), selecionado em runtime por
        QUARKUS_PROFILE=kubernetes. O extension quarkus-kubernetes-client carrega o
        suporte nativo do fabric8 (reflection/config) e o cliente HTTP Vert.x. -->
        <dependency>
            <groupId>io.smallrye.stork</groupId>
            <artifactId>stork-service-discovery-kubernetes</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-kubernetes-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-micrometer</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cap.5 do livro: RestAssured para testes REST de nível HTTP. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Cap.5.3.2: integração com Mockito (QuarkusMock). Atenção: a partir do Quarkus 3.31
            o artefato quarkus-junit5-mockito foi relocado para quarkus-junit-mockito.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit-mockito</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cap.7.7 - suporte a teste reativo (TransactionalUniAsserter + @RunOnVertxContext). -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-hibernate-reactive-panache</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cap.10 item 10 - mock do API server Kubernetes para o teste de discovery
        via provider Stork kubernetes (roadmap item 10): o QuarkusTestResource herda
        do KubernetesServerTestResource e o provider fabric8 do Stork le os
        kubernetes.master/namespace setados por ele. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-test-kubernetes-client</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Cap.10 item 9 - testcontainers sobe o Consul real usado pelo teste de registro. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Cap.10 item 10 - profile docker: gera a imagem do servico (quarkus-container-image-docker)
             com tag imutavel ${project.version}; o compose a consome via image: + pull_policy: never. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-container-image-docker</artifactId>
        </dependency>
        <!-- Cap.10 item 10 - profile kubernetes: gera os manifests (Deployment/Service) com
             a imagem acme/<artifactId>:<version>; arquivos versionados em others/k8s/.
             A implantacao em si (aplicar/registrar o servico no Service) fica p/ itens 11/12. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-kubernetes</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>${quarkus.platform.group-id}</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
                <version>${quarkus.platform.version}</version>
                <extensions>true</extensions>
            </plugin>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${compiler-plugin.version}</version>
                <configuration>
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <excludedGroups>${acme.test.discovery.excludedGroups}</excludedGroups>
                    <systemPropertyVariables>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${surefire-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <argLine>@{argLine}</argLine>
                    <systemPropertyVariables>
                        <native.image.path>${project.build.directory}/${project.build.finalName}-runner</native.image.path>
                        <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
                        <maven.home>${maven.home}</maven.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>kubernetes</id>
            <!-- Seleciona os testes @Tag("kubernetes") no lugar dos @Tag("consul");
                 package com este profile gera tambem os manifests (quarkus-kubernetes). -->
            <properties>
                <acme.test.discovery.excludedGroups>consul</acme.test.discovery.excludedGroups>
            </properties>
        </profile>
        <profile>
            <id>docker</id>
            <!-- Imagem pre-construida com tag imutavel (${project.version}) consumida pelo
                 compose (image: + pull_policy: never, scripts/build-images.sh). Com
                 -P native,docker a mesma instrucao gera a imagem NATIVA do servico. -->
            <properties>
                <quarkus.container-image.build>true</quarkus.container-image.build>
            </properties>
        </profile>
        <profile>
            <id>native</id>
            <activation>
                <property>
                    <name>native</name>
                </property>
            </activation>
            <properties>
                <quarkus.package.jar.enabled>false</quarkus.package.jar.enabled>
                <skipITs>false</skipITs>
                <quarkus.native.enabled>true</quarkus.native.enabled>
            </properties>
        </profile>
    </profiles>
</project>
