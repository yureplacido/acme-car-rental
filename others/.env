USER_SERVICE_PORT=8080
RESERVATION_PORT=8081
RENTAL_PORT=8082
INVENTORY_PORT=8083
BILLING_PORT=8084
GATEWAY_PORT=8090
DASHBOARD_PORT=8095
KEYCLOAK_PORT=7777

# Tag imutavel das imagens dos servicos (buildadas por scripts/build-images.sh via
# Maven profile docker). Deve casar com ${project.version} dos poms (1.0.0-SNAPSHOT).
ACME_IMAGE_TAG=1.0.0-SNAPSHOT

# Perfil ativo por padrao: `docker compose up` sobe so o agregador (traefik+swagger).
# Para mais grupos, passe --profile: all | services | databases | identity.
# (ex.: docker compose up -d --profile all)
COMPOSE_PROFILES=infra